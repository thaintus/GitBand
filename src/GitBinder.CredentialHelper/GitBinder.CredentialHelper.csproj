<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gitbinder-credential</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitBinder.Application\GitBinder.Application.csproj" />
    <ProjectReference Include="..\GitBinder.Domain\GitBinder.Domain.csproj" />
    <ProjectReference Include="..\GitBinder.Infrastructure\GitBinder.Infrastructure.csproj" />
    <ProjectReference Include="..\GitBinder.Platform\GitBinder.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

</Project>
