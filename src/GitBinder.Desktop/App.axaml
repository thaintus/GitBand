<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitBinder.Desktop.App"
             xmlns:local="using:GitBinder.Desktop"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#EAF1FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE4EF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="NavigationBrush" Color="#111C33" />
        <SolidColorBrush x:Key="NavigationMutedBrush" Color="#A9B7CE" />
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://GitBinder.Desktop/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
