<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitBinder.Desktop.ViewModels"
             xmlns:loc="using:GitBinder.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GitBinder.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" Spacing="14">
            <StackPanel Spacing="5" Margin="0,0,0,4">
                <TextBlock Classes="page-title" Text="{loc:Loc Dashboard.Title}" />
                <TextBlock Classes="page-description" Text="{loc:Loc Dashboard.Description}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Classes="card" Padding="16">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="32">
                            <TextBlock Classes="caption" Text="{loc:Loc Dashboard.AccountCount}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource PrimarySoftBrush}">
                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7 Z M4,21 V19 A5,5 0 0 1 9,14 H15 A5,5 0 0 1 20,19 V21" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Height="38" FontSize="30" FontWeight="SemiBold" Text="{Binding AccountCount}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Classes="card" Padding="16">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="32">
                            <TextBlock Classes="caption" Text="{loc:Loc Dashboard.ProjectCount}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}">
                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.7"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M3,5 H9 L12,8 H21 V20 H3 Z M3,11 H21" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Height="38" FontSize="30" FontWeight="SemiBold" Text="{Binding ProjectCount}" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Classes="card" Padding="16">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="32">
                            <TextBlock Classes="caption" Text="{loc:Loc Dashboard.BindingCount}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WarningSoftBrush}">
                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.7"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M10,13 A4,4 0 0 0 16,13 L20,9 A4,4 0 0 0 14,3 L11,6 M14,11 A4,4 0 0 0 8,11 L4,15 A4,4 0 0 0 10,21 L13,18" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Height="38" FontSize="30" FontWeight="SemiBold" Text="{Binding BindingCount}" />
                    </Grid>
                </Border>
                <Border Grid.Column="3" Classes="card" Padding="16">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="32">
                            <TextBlock Classes="caption" Text="{loc:Loc Dashboard.DefaultAccountLabel}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource PrimarySoftBrush}">
                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12,3 L15,9 L22,10 L17,15 L18,22 L12,19 L6,22 L7,15 L2,10 L9,9 Z" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Height="38" FontSize="18" FontWeight="SemiBold" Padding="0,8,0,0"
                                   Text="{Binding DefaultAccountAlias}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding DefaultAccountAlias}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Classes="card" Padding="22,20">
                <Grid ColumnDefinitions="*,64" ColumnSpacing="24">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="11" FontWeight="SemiBold" LetterSpacing="1"
                                   Foreground="{DynamicResource PrimaryBrush}" Text="{loc:Loc Dashboard.Hero.Kicker}" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{loc:Loc Dashboard.Hero.Title}" TextWrapping="Wrap" />
                        <SelectableTextBlock FontSize="13" LineHeight="21" Foreground="{DynamicResource TextSecondaryBrush}"
                                             Text="{loc:Loc Dashboard.Hero.Body}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="64" Height="64" CornerRadius="18"
                            Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center">
                        <Path Width="32" Height="36" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}"
                              StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M6,7 V21 M6,15 C6,10 18,15 18,7 M9,4 A3,3 0 1 1 3,4 A3,3 0 1 1 9,4 Z M21,4 A3,3 0 1 1 15,4 A3,3 0 1 1 21,4 Z M9,24 A3,3 0 1 1 3,24 A3,3 0 1 1 9,24 Z" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
