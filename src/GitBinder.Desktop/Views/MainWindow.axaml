<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitBinder.Desktop.ViewModels"
        xmlns:loc="using:GitBinder.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="GitBinder.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="640"
        Title="GitBind - Git Repository Account Binding Manager">

    <Grid Background="{DynamicResource AppBackgroundBrush}" RowDefinitions="Auto,*">

        <!-- 全局模式：无论是否开启都保留明确、稳定的上下文。 -->
        <Border Grid.Row="0" Background="#FFF9EB" BorderBrush="#F8D78A" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                <Border Width="30" Height="30" CornerRadius="15" Background="#FDE7B3" VerticalAlignment="Center">
                    <TextBlock Text="◆" Foreground="#A16207" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc GlobalMode.BannerLabel}" FontSize="12" FontWeight="Bold" Foreground="#A16207" />
                    <TextBlock Text="·" Foreground="#C0841A" />
                    <TextBlock Text="{loc:Loc GlobalMode.CurrentAccountLabel}" FontSize="13" Foreground="#7C5A12" />
                    <TextBlock Text="{Binding GlobalAccountAlias}" FontSize="13" FontWeight="SemiBold" Foreground="#513A08" />
                    <TextBlock Text="{Binding GlobalModeFeedback}" FontSize="12" Foreground="#B91C1C" />
                </StackPanel>
                <ComboBox Grid.Column="2" Width="190"
                          ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedGlobalAccount}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayAlias}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="3" Content="{loc:Loc GlobalMode.EnableBtn}"
                        Command="{Binding EnableGlobalModeCommand}"
                        Classes="primary"
                        IsVisible="{Binding GlobalModeDisabled}" />
                <Button Grid.Column="3" Content="{loc:Loc GlobalMode.ChangeAccount}"
                        Command="{Binding SwitchGlobalAccountCommand}"
                        Classes="primary"
                        IsVisible="{Binding GlobalModeEnabled}" />
                <Button Grid.Column="4" Content="{loc:Loc GlobalMode.DisableBtn}"
                        Command="{Binding DisableGlobalModeCommand}"
                        Classes="ghost"
                        IsVisible="{Binding GlobalModeEnabled}" />
            </Grid>
        </Border>

        <!-- 主内容：侧边导航 + 页面 -->
        <Grid Grid.Row="1" ColumnDefinitions="238,*">

            <!-- 侧边导航 -->
            <Border Grid.Column="0" Background="{DynamicResource NavigationBrush}">
                <Grid Margin="16,18" RowDefinitions="Auto,*">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32" Height="32" CornerRadius="9" Background="#3B82F6">
                                <TextBlock Text="G" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="17" FontWeight="Bold" Foreground="White" Text="GitBind" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource NavigationMutedBrush}" Text="Repository identity" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="2,10,0,6" FontSize="11" FontWeight="SemiBold" Foreground="#7890B2" Text="{loc:Loc Ui.Navigation.Section}" />
                    </StackPanel>

                    <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNav}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource NavigationMutedBrush}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="#263859" />
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 直接设置文字颜色，避免 Fluent 的 ListBox 控件模板覆盖侧栏的高对比度配色。 -->
                                <TextBlock Text="{Binding Label}" Padding="13,10" FontSize="14" FontWeight="SemiBold" Foreground="#D8E2F1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>

            <!-- 页面内容 -->
            <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>
