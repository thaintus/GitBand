<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitBinder.Desktop.ViewModels"
        xmlns:accounts="clr-namespace:GitBinder.Domain.Accounts;assembly=GitBinder.Domain"
        xmlns:loc="using:GitBinder.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="GitBinder.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="640"
        Title="{loc:Loc App.Title}">

    <Grid Background="{DynamicResource AppBackgroundBrush}" ColumnDefinitions="216,*">
        <!-- 侧栏贯穿窗口，导航与工作区保持稳定分区。 -->
        <Border Background="{DynamicResource NavigationBrush}">
            <Grid Margin="16,24,16,20" RowDefinitions="Auto,Auto,*">
                <Grid Margin="8,0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="G" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource OnPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="GitBind" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource NavigationTextBrush}" />
                        <TextBlock Text="{loc:Loc Ui.Navigation.Tagline}" FontSize="11" Foreground="{DynamicResource NavigationMutedBrush}" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Margin="14,30,0,10" Text="{loc:Loc Ui.Navigation.Section}" FontSize="10"
                           LetterSpacing="1.4" FontWeight="SemiBold" Foreground="{DynamicResource NavigationMutedBrush}" />
                <ListBox Grid.Row="2" Classes="sidebar" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNav}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <Grid ColumnDefinitions="20,*" ColumnSpacing="12">
                                <Path Data="{Binding Icon}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                      Stroke="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- 全局控制始终可见；状态与账号信息不再使用警告色横幅。 -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="28,12">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}">
                                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                      Data="M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 M2,12 H22 M12,2 C6,8 6,16 12,22 C18,16 18,8 12,2" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Loc Dashboard.GlobalMode}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Classes="badge badge-success" Padding="7,3" IsVisible="{Binding GlobalModeEnabled}">
                                        <TextBlock Text="{Binding GlobalModeStatusText}" FontSize="11" />
                                    </Border>
                                    <Border Classes="badge" Padding="7,3" IsVisible="{Binding GlobalModeDisabled}">
                                        <TextBlock Text="{Binding GlobalModeStatusText}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="caption" Text="{loc:Loc GlobalMode.CurrentAccountLabel}" />
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding GlobalAccountAlias}" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding GlobalAccountAlias}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox Width="148" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedGlobalAccount}"
                                      AutomationProperties.Name="{loc:Loc GlobalMode.CurrentAccountLabel}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="accounts:Account">
                                        <TextBlock Text="{Binding DisplayAlias}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayAlias}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="{loc:Loc GlobalMode.EnableBtn}" Command="{Binding EnableGlobalModeCommand}"
                                    Classes="primary" IsVisible="{Binding GlobalModeDisabled}" />
                            <Button Content="{loc:Loc GlobalMode.ChangeAccount}" Command="{Binding SwitchGlobalAccountCommand}"
                                    Classes="primary" IsVisible="{Binding GlobalModeEnabled}" />
                            <Button Content="{loc:Loc GlobalMode.DisableBtn}" Command="{Binding DisableGlobalModeCommand}"
                                    Classes="ghost" IsVisible="{Binding GlobalModeEnabled}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
