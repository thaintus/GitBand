<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitBinder.Desktop.ViewModels"
             xmlns:loc="using:GitBinder.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GitBinder.Desktop.Views.PlatformsView"
             x:DataType="vm:PlatformsViewModel">

    <Grid Margin="28,24" RowDefinitions="Auto,Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="5">
                <TextBlock Classes="page-title" Text="{loc:Loc Platforms.Title}" />
                <TextBlock Classes="page-description" Text="{loc:Loc Platforms.Description}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{loc:Loc Platforms.RestoreDefaults}" Command="{Binding RestoreDefaultsCommand}" Classes="ghost" />
                <Button Command="{Binding NewCommand}" Classes="primary" AutomationProperties.Name="{loc:Loc Common.Add.New}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="action-glyph" Data="M12,5 V19 M5,12 H19" />
                        <TextBlock Text="{loc:Loc Common.Add.New}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{loc:Loc Platforms.SearchPlaceholder}"
                     AutomationProperties.Name="{loc:Loc Platforms.SearchPlaceholder}" Padding="38,9,40,9" />
            <Path Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Stretch="Uniform" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.7"
                  IsHitTestVisible="False" Data="M10,2 A8,8 0 1 1 10,18 A8,8 0 1 1 10,2 M16,16 L22,22" />
            <Button Command="{Binding ClearSearchCommand}" Classes="ghost icon-action small"
                    IsVisible="{Binding HasSearchText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                    ToolTip.Tip="{loc:Loc Common.Search.Clear}" AutomationProperties.Name="{loc:Loc Common.Search.Clear}">
                <Path Classes="action-glyph" Data="M6,6 L18,18 M18,6 L6,18" />
            </Button>
        </Grid>

        <!-- 编辑表单 -->
        <Border Grid.Row="2" Margin="0,14,0,0" Classes="card" Padding="16" IsVisible="{Binding IsEditorOpen}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" FontWeight="SemiBold" Text="{loc:Loc Platforms.Name}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="caption" FontWeight="SemiBold" Text="{loc:Loc Common.Host}" />
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding EditName}" PlaceholderText="{loc:Loc Platforms.NamePlaceholder}"
                         AutomationProperties.Name="{loc:Loc Platforms.Name}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditHost}" PlaceholderText="{loc:Loc Platforms.HostPlaceholder}"
                         AutomationProperties.Name="{loc:Loc Common.Host}" />
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc Common.Cancel}" Command="{Binding CancelEditCommand}" Classes="ghost" />
                    <Button Content="{loc:Loc Common.Save}" Command="{Binding SaveCommand}" Classes="primary" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 平台列表 -->
        <ScrollViewer Grid.Row="3" Margin="0,14,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Classes="card" Padding="32" IsVisible="{Binding !HasItems}">
                    <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="360">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Center">
                            <Path Width="26" Height="26" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                  Data="M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 M2,12 H22 M12,2 C6,7 6,17 12,22 M12,2 C18,7 18,17 12,22" />
                        </Border>
                        <TextBlock Classes="page-description" Text="{loc:Loc Platforms.Description}" TextAlignment="Center" />
                        <Button Content="{loc:Loc Common.Add.New}" Command="{Binding NewCommand}" Classes="secondary" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Padding="32" IsVisible="{Binding HasNoMatches}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="360">
                        <TextBlock Classes="section-title" Text="{loc:Loc Common.Search.NoResults}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Classes="page-description" Text="{loc:Loc Common.Search.NoResultsHint}" TextAlignment="Center" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding FilteredItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card list-card" Margin="0,0,0,10">
                                <Grid>
                                    <Grid Margin="16,18,44,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center">
                                            <Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7"
                                                  Data="M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 M2,12 H22 M12,2 C6,7 6,17 12,22 M12,2 C18,7 18,17 12,22" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Classes="section-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <TextBlock Classes="caption" Text="{loc:Loc Common.Host}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding Host}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Host}" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Classes="badge badge-success" VerticalAlignment="Center" IsVisible="{Binding Enabled}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding StatusText}" />
                                            </Border>
                                            <Border Classes="badge badge-danger" VerticalAlignment="Center" IsVisible="{Binding !Enabled}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Text="{Binding StatusText}" />
                                            </Border>
                                            <Button Content="{Binding ToggleText}" Command="{Binding $parent[ItemsControl].((vm:PlatformsViewModel)DataContext).ToggleEnabledCommand}"
                                                    CommandParameter="{Binding}" Classes="ghost compact" />
                                            <Button Command="{Binding $parent[ItemsControl].((vm:PlatformsViewModel)DataContext).StartEditCommand}"
                                                    CommandParameter="{Binding}" Classes="secondary icon-action"
                                                    ToolTip.Tip="{loc:Loc Common.Edit}" AutomationProperties.Name="{loc:Loc Common.Edit}">
                                                <Path Classes="action-glyph" Data="M14,5 L19,10 M3,21 L8,20 L21,7 A2,2 0 0 0 17,3 L4,16 Z" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Button Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Content="×"
                                            ToolTip.Tip="{loc:Loc Common.Delete}"
                                            AutomationProperties.Name="{loc:Loc Common.Delete}"
                                            Command="{Binding $parent[ItemsControl].((vm:PlatformsViewModel)DataContext).DeleteCommand}"
                                            CommandParameter="{Binding}" Classes="icon-danger" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
