<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitBinder.Desktop.ViewModels"
             xmlns:loc="using:GitBinder.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GitBinder.Desktop.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

    <Grid Margin="32,28" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="7">
                <TextBlock Classes="page-title" Text="{loc:Loc Nav.Accounts}" />
                <TextBlock Classes="page-description" Text="{loc:Loc Accounts.Description}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{loc:Loc Accounts.New}" Command="{Binding AddCommand}" Classes="primary" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Grid>
                <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{loc:Loc Accounts.SearchPlaceholder}"
                         AutomationProperties.Name="{loc:Loc Accounts.SearchPlaceholder}" Padding="38,9,12,9" />
                <Path Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Stretch="Uniform" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.7"
                      IsHitTestVisible="False" Data="M10,2 A8,8 0 1 1 10,18 A8,8 0 1 1 10,2 M16,16 L22,22" />
            </Grid>
            <Button Grid.Column="1" Content="{loc:Loc Common.Search.Clear}" Command="{Binding ClearSearchCommand}"
                    Classes="ghost" IsVisible="{Binding HasSearchText}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Classes="card" Padding="32" IsVisible="{Binding !HasItems}">
                    <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="360">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Center">
                            <Path Width="26" Height="26" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                  Data="M12,3 A4,4 0 1 1 12,11 A4,4 0 1 1 12,3 M4,22 V19 A7,7 0 0 1 11,12 H13 A7,7 0 0 1 20,19 V22" />
                        </Border>
                        <TextBlock Classes="page-description" Text="{loc:Loc Accounts.Description}" TextAlignment="Center" />
                        <Button Content="{loc:Loc Accounts.New}" Command="{Binding AddCommand}" Classes="secondary" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Padding="32" IsVisible="{Binding HasNoMatches}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="360">
                        <TextBlock Classes="section-title" Text="{loc:Loc Common.Search.NoResults}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Classes="page-description" Text="{loc:Loc Common.Search.NoResultsHint}" TextAlignment="Center" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding FilteredItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Margin="0,0,0,12">
                                <Grid>
                                    <Grid Margin="22,24,44,24" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                        <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Top">
                                            <Path Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                                  Data="M12,3 A4,4 0 1 1 12,11 A4,4 0 1 1 12,3 M4,22 V19 A7,7 0 0 1 11,12 H13 A7,7 0 0 1 20,19 V22" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" HorizontalAlignment="Left">
                                                <TextBlock Classes="section-title" Text="{Binding DisplayAlias}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding DisplayAlias}" />
                                                <Border Grid.Column="1" Classes="badge badge-warning" IsVisible="{Binding IsDefault}" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc Accounts.Default}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                                </Border>
                                            </Grid>
                                            <WrapPanel>
                                                <Border Classes="badge" Margin="0,0,10,4" MaxWidth="260">
                                                    <TextBlock Classes="caption" Text="{Binding PlatformText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PlatformText}" />
                                                </Border>
                                                <TextBlock Classes="caption" Margin="0,4,0,4" Text="{Binding EmailText}" TextWrapping="Wrap" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="{loc:Loc Accounts.SetDefault}" Command="{Binding $parent[ItemsControl].((vm:AccountsViewModel)DataContext).SetDefaultCommand}"
                                                    CommandParameter="{Binding}" Classes="ghost" />
                                            <Button Content="{loc:Loc Accounts.Edit}" Command="{Binding $parent[ItemsControl].((vm:AccountsViewModel)DataContext).EditCommand}"
                                                    CommandParameter="{Binding}" Classes="secondary" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Content="×"
                                            ToolTip.Tip="{loc:Loc Accounts.Delete}"
                                            AutomationProperties.Name="{loc:Loc Accounts.Delete}"
                                            Command="{Binding $parent[ItemsControl].((vm:AccountsViewModel)DataContext).DeleteCommand}"
                                            CommandParameter="{Binding}" Classes="icon-danger" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding Feedback}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
