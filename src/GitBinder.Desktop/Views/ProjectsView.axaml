<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitBinder.Desktop.ViewModels"
             xmlns:loc="using:GitBinder.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GitBinder.Desktop.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">

    <Grid Margin="32,28" RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="5">
                <TextBlock FontSize="28" FontWeight="Bold" Text="{loc:Loc Nav.Projects}" />
                <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc Projects.Description}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{loc:Loc Projects.Add}" Command="{Binding CreateCommand}" Classes="primary" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,24,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="0" Margin="0,0,0,4">
                                <Grid>
                                    <Grid Margin="20" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                        <Border Width="30" Height="30" CornerRadius="8" Background="#ECFDF5">
                                            <TextBlock Text="⌘" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Name}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,30,0" Orientation="Horizontal" Spacing="4">
                                        <Button Content="{loc:Loc Projects.EditRemote}" Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).StartEditRemoteCommand}"
                                                CommandParameter="{Binding}" Classes="ghost" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                        <Border Background="#EAF1FF" CornerRadius="7" Padding="8,3">
                                            <TextBlock FontSize="12" Foreground="#1D4ED8" Text="{Binding BoundAccountLabel}" />
                                        </Border>
                                        <Border Background="#ECFDF5" CornerRadius="7" Padding="8,3">
                                            <TextBlock FontSize="12" Foreground="#047857" Text="{Binding EffectiveAccountLabel}" />
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="7" Padding="8,3">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ProtocolLabel}" />
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="7" Padding="8,3">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding HostLabel}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding OriginUrlDisplay}" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10" Padding="12,9"
                                            IsVisible="{Binding IsRemoteEditorOpen}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc Projects.RemoteUrl}" />
                                            <TextBox Grid.Column="1" Text="{Binding EditingOriginUrl, Mode=TwoWay}" PlaceholderText="{loc:Loc Projects.RemoteUrlPlaceholder}" />
                                            <Button Grid.Column="2" Content="{Binding RemoteProtocolSwitchText}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).SwitchRemoteProtocolCommand}"
                                                    CommandParameter="{Binding}" Classes="ghost" />
                                            <Button Grid.Column="3" Content="{loc:Loc Projects.SaveRemote}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).SaveRemoteCommand}"
                                                    CommandParameter="{Binding}" Classes="ghost" />
                                            <Button Grid.Column="4" Content="{loc:Loc Common.Cancel}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).CancelEditRemoteCommand}"
                                                    CommandParameter="{Binding}" Classes="ghost" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="4" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10" Padding="12,9">
                                        <Grid ColumnDefinitions="Auto,190,Auto,Auto,*" ColumnSpacing="8">
                                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{loc:Loc Projects.BindAccount}" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableAccounts}" SelectedItem="{Binding SelectedBindingAccount}"
                                                      SelectionChanged="OnBindingAccountSelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayAlias}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="2" Content="{loc:Loc Common.Test}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).TestBindingCommand}"
                                                    CommandParameter="{Binding}" Classes="ghost" IsEnabled="{Binding HasBinding}" />
                                            <Button Grid.Column="3" Content="{loc:Loc Projects.Unbind}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).UnbindCommand}"
                                                    CommandParameter="{Binding}" Classes="danger" IsEnabled="{Binding HasBinding}" />
                                            <Border Grid.Column="4" Background="#ECFDF5" CornerRadius="7" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#047857" Text="{Binding EffectiveReasonLabel}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="5" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PathText}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Button Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Content="×"
                                            ToolTip.Tip="{loc:Loc Projects.Remove}"
                                            Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).RemoveCommand}"
                                            CommandParameter="{Binding}" Classes="icon-danger" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Margin="0,12,0,0" Text="{Binding Feedback}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
