<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitBinder.Desktop.ViewModels"
             xmlns:loc="using:GitBinder.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GitBinder.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" Spacing="14">
            <StackPanel Spacing="5" Margin="0,0,0,4">
                <TextBlock Classes="page-title" Text="{loc:Loc Nav.Settings}" />
                <TextBlock Classes="page-description" Text="{loc:Loc Settings.Description}" />
            </StackPanel>

            <Border Classes="card" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Classes="section-title" Text="{loc:Loc Settings.General}" />
                    <Grid ColumnDefinitions="32,*,164" ColumnSpacing="12">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center">
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M22,12 A10,10 0 1 1 2,12 A10,10 0 1 1 22,12 Z M2,12 H22 M12,2 C6,8 6,16 12,22 C18,16 18,8 12,2" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Loc Settings.LanguageLabel}" />
                            <SelectableTextBlock FontSize="12" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}"
                                                 Text="{loc:Loc Settings.LanguageDesc}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  AutomationProperties.Name="{loc:Loc Settings.LanguageLabel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center">
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M3,3 H21 V16 H3 Z M8,21 H16 M12,16 V21 M3,12 H21" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Loc Settings.Tray}" />
                            <SelectableTextBlock FontSize="12" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}"
                                                 Text="{loc:Loc Settings.CloseToTrayDesc}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
                                      IsChecked="{Binding CloseToTrayOnClose}"
                                      AutomationProperties.Name="{loc:Loc Settings.Tray}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource SuccessSoftBrush}">
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.7"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M3,5 L10,12 L3,19 M12,19 H21" />
                        </Border>
                        <TextBlock Grid.Column="1" Classes="section-title" VerticalAlignment="Center" Text="{loc:Loc Settings.Git}" />
                        <Button Grid.Column="2" Command="{Binding DetectCommand}" Classes="ghost compact" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Loc Settings.Detect}" AutomationProperties.Name="{loc:Loc Settings.Detect}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="action-glyph" Data="M20,8 A8,8 0 1 0 21,14 M20,3 V8 H15" />
                                <TextBlock Text="{loc:Loc Settings.Detect}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="128,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <TextBlock Classes="caption" Text="{loc:Loc Settings.RealGit}" TextWrapping="Wrap" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding RealGitPath}" TextWrapping="Wrap"
                                             FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI, monospace" FontSize="12" LineHeight="19"
                                             Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="{Binding RealGitPath}"
                                             AutomationProperties.Name="{loc:Loc Settings.RealGit}" />
                        <TextBlock Grid.Row="1" Classes="caption" Text="{loc:Loc Settings.SshExecutable}" TextWrapping="Wrap" />
                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SshExecutable}" TextWrapping="Wrap"
                                             FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI, monospace" FontSize="12" LineHeight="19"
                                             Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="{Binding SshExecutable}"
                                             AutomationProperties.Name="{loc:Loc Settings.SshExecutable}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource WarningSoftBrush}">
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.7"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M3,6 C3,1 21,1 21,6 C21,11 3,11 3,6 Z M3,6 V18 C3,23 21,23 21,18 V6 M3,12 C3,17 21,17 21,12" />
                        </Border>
                        <TextBlock Classes="section-title" VerticalAlignment="Center" Text="{loc:Loc Settings.Storage}" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="128,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <TextBlock Classes="caption" Text="{loc:Loc Settings.Database}" TextWrapping="Wrap" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding DatabasePath}" TextWrapping="Wrap"
                                             FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI, monospace" FontSize="12" LineHeight="19"
                                             Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="{Binding DatabasePath}"
                                             AutomationProperties.Name="{loc:Loc Settings.Database}" />
                        <TextBlock Grid.Row="1" Classes="caption" Text="{loc:Loc Settings.DataDirectory}" TextWrapping="Wrap" />
                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataDirectory}" TextWrapping="Wrap"
                                             FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI, monospace" FontSize="12" LineHeight="19"
                                             Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="{Binding DataDirectory}"
                                             AutomationProperties.Name="{loc:Loc Settings.DataDirectory}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
