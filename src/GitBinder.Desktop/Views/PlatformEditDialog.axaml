<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitBinder.Desktop.Localization"
        x:Class="GitBinder.Desktop.Views.PlatformEditDialog"
        Width="480" MinHeight="360" MaxHeight="560" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource SurfaceBrush}"
        Opened="OnOpened" Closing="OnClosing" KeyDown="OnKeyDown">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24" Spacing="22">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Width="40" Height="40" CornerRadius="12"
                            Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Top">
                        <Path Width="20" Height="20" Stretch="Uniform"
                              Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 M2,12 H22 M12,2 C6,7 6,17 12,22 M12,2 C18,7 18,17 12,22" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <SelectableTextBlock Text="{loc:Loc Platforms.Editor.Hint}"
                                             FontSize="12" LineHeight="20" TextWrapping="Wrap"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Loc Platforms.Name}" Classes="caption" FontWeight="Medium" />
                        <TextBox x:Name="NameInput" MinHeight="40"
                                 PlaceholderText="{loc:Loc Platforms.NamePlaceholder}"
                                 AutomationProperties.Name="{loc:Loc Platforms.Name}" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Loc Common.Host}" Classes="caption" FontWeight="Medium" />
                        <TextBox x:Name="HostInput" MinHeight="40"
                                 PlaceholderText="{loc:Loc Platforms.HostPlaceholder}"
                                 AutomationProperties.Name="{loc:Loc Common.Host}" />
                    </StackPanel>
                    <Border x:Name="ErrorPanel" IsVisible="False" Padding="12,10" CornerRadius="10"
                            Background="{DynamicResource DangerSoftBrush}">
                        <SelectableTextBlock x:Name="ErrorText" FontSize="12" LineHeight="20"
                                             TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Padding="28,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceMutedBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{loc:Loc Common.Cancel}" Classes="ghost"
                        MinWidth="80" MinHeight="36" Click="OnCancelClick" />
                <Button x:Name="SaveButton" Content="{loc:Loc Common.Save}" Classes="primary"
                        MinWidth="92" MinHeight="36" IsDefault="True" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
