<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GitBinder.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="210"
        x:Class="GitBinder.Desktop.Views.ConfirmationDialog"
        x:DataType="local:ConfirmationDialog"
        Width="420" MinHeight="210"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown"
        Title="{Binding Title}">

    <Grid Margin="28,24" RowDefinitions="Auto,*,Auto" RowSpacing="18">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Grid.Row="1" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button MinWidth="88" Content="{Binding CancelText}" Click="OnCancelClick" Classes="ghost" />
            <Button MinWidth="88" Content="{Binding ConfirmText}" Click="OnConfirmClick" Classes="danger" />
        </StackPanel>
    </Grid>
</Window>
