<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Fake 仓储为纯内存同步实现，测试中使用阻塞等待是安全且简洁的，关闭该分析器警告。 -->
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GitBinder.Domain\GitBinder.Domain.csproj" />
    <ProjectReference Include="..\..\src\GitBinder.Application\GitBinder.Application.csproj" />
    <ProjectReference Include="..\..\src\GitBinder.Infrastructure\GitBinder.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\GitBinder.Platform\GitBinder.Platform.csproj" />
    <ProjectReference Include="..\..\src\GitBinder.Desktop\GitBinder.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
